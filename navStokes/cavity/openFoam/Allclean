#!/bin/bash

# Run from this directory
cd "${0%/*}" || exit 1

# Remove all time directories except 0
for d in */; do
    name="${d%/}"

    if [ "$name" = "0" ]; then
        continue
    fi

    if [[ "$name" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        echo "Removing $name"
        rm -rf "$name"
    fi
done

# Remove stale parallel-decomposition output. These carry their own
# time directories and mesh addressing (cellProcAddressing etc.) sized for
# whatever mesh existed when decomposePar last ran -- if the mesh is
# regenerated afterwards (different cell count), leftover processorN/<time>
# field files silently mismatch the next decomposePar/reconstructPar's
# addressing (FOAM FATAL IO ERROR: size X is not equal to the given value
# of Y) instead of erroring at decompose time.
for d in processor*/; do
    name="${d%/}"
    echo "Removing $name"
    rm -rf "$name"
done

