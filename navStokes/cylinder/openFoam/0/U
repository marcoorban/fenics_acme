FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [velocity];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        // Time-modulated parabolic (Poiseuille) inflow profile (DFG 2D-3):
        //   U(0, y, t) = 4 Um y (H - y) / H^2 * sin(pi*t/8),  V = 0
        // Um is the same peak-velocity constant as the steady/2D-2 cases
        // (unchanged); the sin(pi*t/8) factor ramps the whole profile from
        // 0 up to its 2D-2 peak shape at t=2s, back through 0 at t=8s
        // (matching controlDict's endTime -- one full half-sine cycle, not
        // periodic shedding like 2D-2). Reynolds number reasoning (mean
        // velocity Ubar = (2/3) Um, Re = Ubar*D/nu) still applies to the
        // spatial profile's amplitude; nu is unchanged (see
        // constant/physicalProperties).
        type            codedFixedValue;
        value           uniform (0 0 0);
        name            parabolicInlet;

        code
        #{
            const scalar Um = 1.5;   // peak (centerline) inlet velocity [m/s]
            const scalar H  = 0.41;  // channel height [m]
            const scalar t  = this->db().time().value();

            const scalar timeFactor = Foam::sin(Foam::constant::mathematical::pi*t/8.0);

            const vectorField& Cf = patch().Cf();
            vectorField& field = *this;

            forAll(Cf, i)
            {
                const scalar y = Cf[i].y();
                field[i] = vector(4.0*Um*y*(H - y)/sqr(H)*timeFactor, 0, 0);
            }
        #};
    }

    outlet
    {
        type            zeroGradient;
    }

    wall
    {
        type            noSlip;
    }

    cylinder
    {
        type            noSlip;
    }

    empty
    {
        type            empty;
    }
}

